{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"functions/**/*.js\" \"server/**/*.js\" \"shared/**/*.js\" \"*.{html,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"functions/**/*.js\" \"server/**/*.js\" \"shared/**/*.js\"",
    "db:migrate:local": "wrangler d1 migrations apply starsky-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply starsky-db --remote"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "wrangler": "^4.148.0"
  }
}
